APP_NAME="ERP Auditoria IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/La_Paz"
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=auditoria_ia
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuración Laravel Reverb (WebSockets)
REVERB_APP_ID=sis_auditoria_app
REVERB_APP_KEY=sis_auditoria_key
REVERB_APP_SECRET=sis_auditoria_secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Configuración Ollama Local (Embeddings con nomic-embed-text)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nomic-embed-text

# Configuración Groq API Cloud (Dictámenes JSON y Multimodal)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_AUDIT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Configuración de Conexión Read-Only para Text-to-SQL
DB_READONLY_CONNECTION=pgsql_readonly
DB_READONLY_HOST=127.0.0.1
DB_READONLY_PORT=5432
DB_READONLY_DATABASE=auditoria_ia
DB_READONLY_USERNAME=postgres_readonly
DB_READONLY_PASSWORD=secret_readonly
