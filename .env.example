APP_NAME="PETIDENTITY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/La_Paz"
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=petidentity_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# Para ejecución con Podman Compose (puerto mapeado 5433):
# DB_PORT=5433

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=petidentity_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
